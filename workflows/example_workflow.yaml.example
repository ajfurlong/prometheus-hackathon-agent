id: team1-table-plot.example_workflow
name: Team 1 Table and Plot Example Workflow
version: "1.0.0"
description: Example agent-owned workflow for Team 1 Table and Plot. Rename this file to .yaml to publish it.
inputs:
  required:
    - input_data
  optional: []
execution:
  mode: sequential
  max_concurrency: 1
  on_error: fail_fast
steps:
  - id: run_primary_skill
    skill_id: team1_extract_table
    is_final: true
    params:
      input_data:
        from: input.input_data
outputs:
  final:
    from: step.run_primary_skill.result
metadata:
  requires_approval: false
  estimated_duration_seconds: 30
  owner: team1-table-plot
ui:
  category: Team 1 Table and Plot
  display_name: Team 1 Table and Plot Example Workflow
  summary: Example workflow that invokes the primary Team 1 Table and Plot skill.
